# /etc/systemd/system/xfs-signalling.service — XFS signalling (README.md, "Deployment")
[Unit]
Description=XFS signalling
After=network-online.target
Wants=network-online.target

[Service]
# 本地测试用 / for local testing: stun1.anyxfs.cn below is an example host name.
User=xfs-signal
Group=xfs-signal
# Keys and certificates are files, never on this command line (it is visible in ps).
ExecStart=/opt/xfs/xfs-signalling \
  -listen :443 \
  -tls-cert /etc/xfs/tls/fullchain.pem -tls-key /etc/xfs/tls/privkey.pem \
  -ticket-key-file /var/lib/xfs-signalling/ticket-keys \
  -retired-codes-file /var/lib/xfs-signalling/retired-codes \
  -regions-file /etc/xfs/regions.json \
  -events-db /var/lib/xfs-signalling/events.db \
  -stun stun:stun1.anyxfs.cn:3478 \
  -turn-urls turn:stun1.anyxfs.cn:3478?transport=udp \
  -turn-secret-file /etc/xfs/turn-secret \
  -max-connections 20000 \
  -notices-file /etc/xfs/messages/notices.json \
  -notices-cache /var/lib/xfs-signalling/notices.last.json \
  -notices-pubkey n1:REPLACE_WITH_YOUR_NOTICES_PUBLIC_KEY
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
# Binds 443 without root; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# /var/lib/xfs-signalling (0700) holds the ticket keys; everything else read-only.
StateDirectory=xfs-signalling
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
# Service notices (PROTOCOL.md "Service notices"): the operator uploads a signed
# notices.json to its ~/messages (NOTICES_OWNER in signal-host.sh); only that directory
# is visible here, read-only. "-": a host without it still starts, with no notices.
# -notices-pubkey above: the public key `xfs-notice keygen` printed for your signing key.
BindReadOnlyPaths=-/home/operator/messages:/etc/xfs/messages
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
